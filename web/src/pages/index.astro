---
import Hero from '../components/Hero.tsx';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>人格测评量表库</title>
<meta name="description" content="基于公开学术调研的人格测评量表库：98 个量表、15 大流派，可在线作答并导出数据。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&display=swap">
<link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<div id="nav"></div>

<div class="wrap">
  <header class="hero">
    <div class="hero-panel">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-l">
        <span class="hero-brand"><span class="hb-logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 12 0v1"/></svg></span>人格测评量表库</span>
        <h1>系统、开放、可核实的<br>人格测评量表库</h1>
        <p class="lede">整理心理学人格测评领域的 <b>98 个量表</b>、覆盖 <b>15 大流派</b>。区分可在线作答与仅供查阅两类，题项均转录自公开来源并逐条核实，可作答、可导出、非商用。</p>
        <div class="hero-cta">
          <a class="btn-hero" href="fill.html">开始测评
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="hero-link" href="view.html">浏览 98 个量表 →</a>
        </div>
        <div class="hero-badges">
          <span class="hbadge"><b>98</b> 量表</span>
          <span class="hbadge"><b>15</b> 大流派</span>
          <span class="hbadge"><b>6</b> 可在线作答</span>
          <span class="hbadge"><b>公开来源</b> 逐条核实</span>
        </div>
      </div>
      <div class="hero-r">
        <Hero client:load />
      </div>
    </div>
  </header>
</div>

<main class="wrap">
  <div class="statstrip" id="statStrip"></div>

  <section class="discover">
    <div class="disc-col">
      <h3><span class="dc-i"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>可在线作答</span><a href="fill.html">全部 →</a></h3>
      <div id="colFill"></div>
    </div>
    <div class="disc-col">
      <h3><span class="dc-i"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>完整题项</span><a href="view.html?st=full">全部 →</a></h3>
      <div id="colFull"></div>
    </div>
    <div class="disc-col">
      <h3><span class="dc-i"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>按流派浏览</span><a href="view.html">全部 →</a></h3>
      <div id="colCat"></div>
    </div>
  </section>

  <section class="section">
    <div class="section-h"><h2>三大板块</h2></div>
    <div class="portals">
      <a class="portal" href="fill.html">
        <span class="pi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span>
        <h3>问卷填写 · Fill</h3>
        <p>选择感兴趣的量表在线作答，即时生成维度得分与解读，并可导出作答数据（JSON / CSV）。</p>
      </a>
      <a class="portal" href="view.html">
        <span class="pi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></svg></span>
        <h3>问卷查看 · View</h3>
        <p>浏览全库 98 个量表的结构化元数据：题量、维度、计分、版权与数据来源，可按流派/状态筛选。</p>
      </a>
      <a class="portal" href="docs.html">
        <span class="pi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M14 4v6h6"/></svg></span>
        <h3>领域综述 · Docs</h3>
        <p>人格测评领域的系统综述：测量取向的历史脉络、15 大流派逐节评述、方法学横切议题与选用建议。</p>
      </a>
    </div>
  </section>
</main>

<div id="footer"></div>

<script is:inline src="/assets/library.js"></script>
<script is:inline src="/assets/common.js"></script>
<script is:inline>
mountChrome('home');

// stats strip
const fullCnt = LIB.filter(d=>STATUS[d.id]==='full').length;
document.getElementById('statStrip').innerHTML = [
  [LIB.length,'个量表'],[CAT_ORDER.length,'大流派'],[FILLABLE.length,'可在线作答'],[fullCnt,'完整题项']
].map(([b,s])=>`<span class="s"><b>${b}</b><span>${s}</span></span>`).join('');

function rrow(href,id,name,rightHtml){
  return `<a class="rrow" href="${href}">
    <span class="rl"><span class="r-nm">${esc(name)}</span><span class="r-id">${esc(id)}</span></span>
    <span class="rr">${rightHtml}</span></a>`;
}

// col 1: fillable
document.getElementById('colFill').innerHTML = FILLABLE.map(id=>{
  const d=LIB.find(x=>x.id===id); if(!d) return '';
  return rrow(`fill.html?s=${id}`, `${id} · ${esc(d.en)}`, d.n,
    `<span class="r-q">${esc(d.q)}</span><span class="tag tag-fill">可作答</span>`);
}).join('');

// col 2: full items, not already in fillable, by priority then name
const full = LIB.filter(d=>STATUS[d.id]==='full' && !FILLABLE.includes(d.id))
  .sort((a,b)=> a.p-b.p || a.n.localeCompare(b.n,'zh')).slice(0,7);
document.getElementById('colFull').innerHTML = full.map(d=>
  rrow(`view.html?s=${d.id}`, `${d.id} · ${esc(d.en)}`, d.n,
    `<span class="r-q">${esc(d.q)}</span>${stTag(d.id)}`)
).join('');

// col 3: categories
const counts={}; CAT_ORDER.forEach(c=>counts[c]=0); LIB.forEach(d=>counts[d.cat]++);
document.getElementById('colCat').innerHTML = CAT_ORDER.slice(0,8).map(c=>
  `<a class="rrow" href="view.html?cat=${c}">
    <span class="rl" style="display:flex;align-items:center;gap:8px">${catDot(c)}<span class="r-nm">${CATS[c]}</span></span>
    <span class="rr"><span class="r-q">${counts[c]}</span></span></a>`
).join('');
</script>
</body>
</html>
